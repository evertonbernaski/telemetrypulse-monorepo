{
  "name": "telemetrypulse-monorepo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start:frontend": "nx serve fleet-dashboard",
    "build:frontend": "nx build fleet-dashboard",
    "test:frontend": "nx run-many -t test -p fleet-dashboard,shared-ui",
