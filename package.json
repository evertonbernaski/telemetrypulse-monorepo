    "@angular/compiler-cli": "^17.3.12",
    "@nx/angular": "^18.3.5",
    "@nx/eslint": "^18.3.5",
    "@nx/jest": "^18.3.5",
    "@nx/js": "^18.3.5",
    "@nx/workspace": "^18.3.5",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.12.7",
