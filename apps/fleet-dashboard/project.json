{
  "name": "fleet-dashboard",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/fleet-dashboard/src",
  "prefix": "tp",
  "targets": {
    "build": {
      "executor": "@angular-devkit/build-angular:application",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/apps/fleet-dashboard",
        "index": "apps/fleet-dashboard/src/index.html",
        "browser": "apps/fleet-dashboard/src/main.ts",
        "polyfills": ["zone.js"],
        "tsConfig": "apps/fleet-dashboard/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [],
        "styles": ["apps/fleet-dashboard/src/styles.scss"]
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "executor": "@angular-devkit/build-angular:dev-server",
      "configurations": {
        "production": {
          "buildTarget": "fleet-dashboard:build:production"
        },
        "development": {
          "buildTarget": "fleet-dashboard:build:development"
        }
      },
      "defaultConfiguration": "development",
      "options": {
        "proxyConfig": "apps/fleet-dashboard/proxy.conf.json"
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "apps/fleet-dashboard/jest.config.ts"
      }
    }
  }
}
